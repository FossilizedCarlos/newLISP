#!/usr/bin/env newlisp
(context 'PrefixTest)
(set 'names '("" "a" "b" "aa" "ab" "aaa" "aab" "z"))
(dolist (key names)
    (set (sym key PrefixTest) (list key)))
(dolist (key names)
    (unless (= (eval (sym key PrefixTest nil)) (list key))
        (println "FAIL: symbol lookup " key) (exit 1)))
(unless (= (map term (filter (fn (s) (member (term s) names)) (symbols PrefixTest)))
           (sort (copy names)))
    (println "FAIL: symbol ordering") (exit 1))
(dolist (key names)
    (unless (delete (sym key PrefixTest nil))
        (println "FAIL: symbol deletion") (exit 1))
    (when (sym key PrefixTest nil)
        (println "FAIL: deleted symbol found") (exit 1)))
(set (sym "" PrefixTest) 42)
(unless (= (eval (sym "" PrefixTest nil)) 42)
    (println "FAIL: empty symbol recreation") (exit 1))
(context MAIN)
(set (sym "" MAIN) 17)
(unless (= (eval (sym "" MAIN nil)) 17)
    (println "FAIL: empty MAIN symbol") (exit 1))
(delete (sym "" MAIN nil))
(delete 'PrefixTest)
(println ">>>>> symbol prefix SUCCESSFUL")
(exit 0)
