#!/usr/bin/env newlisp
(set 'hi 9223372036854775807 'lo -9223372036854775808)
(define (check value label)
    (unless value (println "FAIL: " label) (exit 1)))
(check (= (+ hi 1) lo) "addition wraps")
(check (= (- lo 1) hi) "subtraction wraps")
(check (= (* lo -1) lo) "multiplication wraps")
(check (= (- lo) lo) "negation wraps")
(check (= (abs lo) lo) "absolute value wraps")
(check (= (/ lo -1) lo) "division wraps")
(check (= (% lo -1) 0) "remainder boundary")
(check (= (<< -1 63) lo) "left shift bits")
(check (= (>> lo 63) -1) "arithmetic right shift")
(check (= (>> lo 0) lo) "zero shift")
(check (not (catch (<< 1 64) 'err)) "large shift rejected")
(check (not (catch (>> 1 -1) 'err)) "negative shift rejected")
(check (not (catch (/ 1 0) 'err)) "zero division rejected")
(check (not (catch (% 1 0) 'err)) "zero remainder rejected")
(set 'n hi)
(check (= (++ n) lo) "increment wraps")
(check (= (-- n) hi) "decrement wraps")
(check (= (int 9223372036854775808.0) hi) "float upper bound saturates")
(check (= (int -9223372036854775808.0) lo) "float lower bound")
(check (= (+ 0 (sqrt -1)) 0) "NaN conversion")
(println ">>>>> integer boundaries SUCCESSFUL")
(exit 0)
