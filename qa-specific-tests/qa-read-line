#!/usr/bin/env newlisp
(set 'path (string (or (env "TMPDIR") "/tmp/") "/qa-read-line-" (sys-info -3)))
(define (check value label)
    (unless value (delete-file path) (println "FAIL: " label) (exit 1)))
(define (lines content , f result line)
    (write-file path content)
    (set 'f (open path "r"))
    (while (set 'line (read-line f)) (push line result -1))
    (close f)
    result)
(check (not (lines "")) "empty file")
(check (= (lines "\n") '("")) "single empty line")
(check (= (lines "\nabc\n\n") '("" "abc" "")) "empty lines")
(check (= (lines "\r\n") '("")) "empty CRLF line")
(check (= (lines "a\r\nb\n") '("a" "b")) "CRLF line")
(check (= (lines "last") '("last")) "EOF without newline")
(lines "\000abc\n") ; must not read before the buffer; NUL truncation is unchanged
(set 'edge (dup "x" 2047))
(check (= (lines (append edge "\n" edge)) (list edge edge)) "full read buffer")
(set 'long (dup "y" 5000))
(check (= (lines (append long "\r\nz\n")) (list long "z")) "long line")
(delete-file path)
(println ">>>>> read-line boundaries SUCCESSFUL")
(exit 0)
