#!/usr/bin/env newlisp
; string copies keep each document at the end of its own allocation
(define (check value label)
    (unless value (println "FAIL: " label) (exit 1)))
(define (rejected doc)
    (and (not (xml-parse (string doc))) (xml-error)))
(check (= (xml-parse (string "<a/>")) '(("ELEMENT" "a" () ()))) "empty element")
(check (= (xml-parse (string "<a b=\"1\"/>")) '(("ELEMENT" "a" (("b" "1")) ()))) "empty element with attribute")
(check (= (xml-parse (string "<a></a>")) '(("ELEMENT" "a" () ()))) "closed element")
(check (= (xml-parse (string "<a><![CDATA[x]]></a>")) '(("ELEMENT" "a" () (("CDATA" "x"))))) "CDATA")
(check (= (xml-parse (string "<a><!-- c --></a>")) '(("ELEMENT" "a" () (("COMMENT" " c "))))) "comment")
(check (= (xml-parse (string "<!---->")) '(("COMMENT" ""))) "empty comment")
(check (rejected "<a") "unterminated tag")
(check (rejected "<!--x") "unterminated comment")
(check (rejected "<!-->") "comment terminator overlaps opening")
(check (rejected "<!--->") "comment terminator overlaps opening dash")
(check (rejected "<![CDATA[]>") "unterminated CDATA")
(println ">>>>> XML parser bounds SUCCESSFUL")
(exit 0)
