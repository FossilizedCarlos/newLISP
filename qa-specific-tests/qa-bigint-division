#!/usr/bin/env newlisp
(define (check value label)
    (unless value (println "FAIL: " label) (exit 1)))
; equal digit counts fill the quotient storage
(check (= (/ 30000000000000000000L 10000000000000000000L) 3L) "equal-length quotient")
(set 'big 1000000000000000000000000000000000000L)
(check (= (/ big big) 1L) "equal operands")
(check (= (% big big) 0L) "zero remainder over all digits")
; a quotient estimate of 2 carries the product into an extra digit
(check (= (/ 999999999L 600000000L) 1L) "single digit product carry")
(check (= (% 999999999L 600000000L) 399999999L) "single digit product carry remainder")
(check (= (/ 999999999999999999L 900000000000000000L) 1L) "two digit product carry")
(check (= (% 9000000000000000000000000000L 5000000000000000000000000001L) 3999999999999999999999999999L)
       "multi-digit remainder")
(check (= (/ big 7L) 142857142857142857142857142857142857L) "shorter divisor")
; q * y + r = x and |r| < |y| for random operands of equal and different lengths
(define (random-bigint digits)
    (bigint (join (map string (cons (+ 1 (rand 9)) (if (> digits 1) (rand 10 (- digits 1)) '()))))))
(seed 1)
(dotimes (i 2000)
    (set 'y (random-bigint (+ 1 (rand 40))))
    (set 'x (random-bigint (max 1 (+ (length y) (- (rand 20) 2)))))
    (if (odd? i) (set 'x (- x)))
    (if (= (% i 4) 2) (set 'y (- y)))
    (set 'q (/ x y) 'r (% x y))
    (check (= (+ (* q y) r) x) (string "division identity " x " " y))
    (check (< (abs r) (abs y)) (string "remainder bound " x " " y)))
(println ">>>>> bigint division storage SUCCESSFUL")
(exit 0)
