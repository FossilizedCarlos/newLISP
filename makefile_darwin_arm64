# Native Apple Silicon executable. Keep objects separate by configuration.
.DEFAULT_GOAL := all
ifeq ($(origin CC),default)
CC := $(shell xcrun --find clang)
endif
CC ?= $(shell xcrun --find clang)
SDKROOT ?= $(shell xcrun --sdk macosx --show-sdk-path)
MODE ?= baseline
ifeq ($(MODE),debug)
DEFAULT_CFLAGS := -O0 -g
else ifneq ($(filter pgo-generate pgo-use,$(MODE)),)
DEFAULT_CFLAGS := -O2 -g
else ifeq ($(MODE),release-o2)
DEFAULT_CFLAGS := -O2 -g
else ifeq ($(MODE),release-o3)
DEFAULT_CFLAGS := -O3 -g
else ifeq ($(MODE),release-lto)
DEFAULT_CFLAGS := -O3 -g -flto=thin
else
DEFAULT_CFLAGS := -O1 -g
endif
ifeq ($(MODE),asan)
MODE_FLAGS := -fsanitize=address -fno-omit-frame-pointer
endif
ifeq ($(MODE),ubsan)
MODE_FLAGS := -fsanitize=undefined -fno-sanitize-recover=all -fno-omit-frame-pointer
endif
CFLAGS ?= $(DEFAULT_CFLAGS)
PROFILE ?= $(abspath build/pgo/current.profdata)
PGO_ENV = PGO_CC='$(CC)' PGO_SDKROOT='$(SDKROOT)' PGO_CPPFLAGS='$(CPPFLAGS)' PGO_CFLAGS='$(CFLAGS)' PGO_LDFLAGS='$(LDFLAGS)' PGO_LDLIBS='$(LDLIBS)'
ifeq ($(MODE),pgo-generate)
MODE_FLAGS := -fprofile-instr-generate=$(abspath build/pgo/raw)/%m-%p.profraw
endif
ifeq ($(MODE),pgo-use)
PROFILE_KEY := $(shell $(PGO_ENV) python3 build-support/pgo.py validate '$(PROFILE)')
ifeq ($(PROFILE_KEY),)
$(error Missing or invalid PGO profile. Run make -f makefile_darwin_arm64 pgo-train MODE=pgo-generate)
endif
MODE_FLAGS := -fprofile-instr-use=$(PROFILE) -Werror=profile-instr-out-of-date -Werror=profile-instr-unprofiled
endif
ARCH := arm64
REQUIRED_CPPFLAGS := -DREADLINE -DNEWLISP64 -DMAC_OSX -DSUPPORT_UTF8 -DFFI
SOURCES := newlisp.c nl-symbol.c nl-math.c nl-list.c nl-liststr.c nl-string.c \
 nl-filesys.c nl-sock.c nl-import.c nl-xml-json.c nl-web.c nl-matrix.c \
 nl-debug.c pcre.c nl-utf8.c
CONFIG_KEY := $(shell printf '%s\n' '$(SDKROOT)' '$(CC)' '$(CPPFLAGS)' '$(CFLAGS)' '$(MODE_FLAGS)' '$(PROFILE_KEY)' '$(LDFLAGS)' '$(LDLIBS)' | shasum | cut -c1-12)
BUILD_DIR := build/$(ARCH)/$(MODE)/$(CONFIG_KEY)
OBJECTS := $(SOURCES:%.c=$(BUILD_DIR)/%.o)
BINARY := $(BUILD_DIR)/newlisp

.PHONY: all clean FORCE
all: $(BINARY)
	cp $(BINARY) newlisp

$(BUILD_DIR)/deps.mk: build-support/apple-silicon-deps.sh makefile_darwin_arm64
	@SDKROOT='$(SDKROOT)' CC='$(CC)' CPPFLAGS='$(CPPFLAGS)' CFLAGS='$(CFLAGS)' LDFLAGS='$(LDFLAGS)' LDLIBS='$(LDLIBS)' sh $< $@

ifneq ($(MAKECMDGOALS),clean)
include $(BUILD_DIR)/deps.mk
endif

$(BUILD_DIR)/%.o: %.c makefile_darwin_arm64 $(BUILD_DIR)/deps.mk
	$(CC) $(CPPFLAGS) $(DEP_CPPFLAGS) $(REQUIRED_CPPFLAGS) $(CFLAGS) $(MODE_FLAGS) -Wall -isysroot "$(SDKROOT)" -arch arm64 -MMD -MP -c $< -o $@

$(BINARY): $(OBJECTS)
	$(CC) $(CFLAGS) $(MODE_FLAGS) $(OBJECTS) $(LDFLAGS) $(DEP_LDFLAGS) -isysroot "$(SDKROOT)" -arch arm64 $(LDLIBS) -lm -lreadline -lffi -o $@

clean:
	rm -rf build/arm64

-include $(OBJECTS:.o=.d)

.PHONY: ffi-check
$(BUILD_DIR)/ffitest.dylib: util/ffitest.c util/arm64-callback.c $(BUILD_DIR)/deps.mk
	$(CC) $(CPPFLAGS) $(DEP_CPPFLAGS) $(CFLAGS) $(MODE_FLAGS) -isysroot "$(SDKROOT)" -arch arm64 -dynamiclib util/ffitest.c util/arm64-callback.c $(LDFLAGS) -o $@

ffi-check: all $(BUILD_DIR)/ffitest.dylib
	NEWLISP_TEST_LIBRARY='$(abspath $(BUILD_DIR)/ffitest.dylib)' sh build-support/run-qa.sh ./newlisp qa-specific-tests/qa-libffi $(BUILD_DIR)/qa-libffi.log
	NEWLISP_TEST_LIBRARY='$(abspath $(BUILD_DIR)/ffitest.dylib)' sh build-support/run-qa.sh ./newlisp qa-specific-tests/qa-arm64-callback $(BUILD_DIR)/qa-arm64-callback.log
	NEWLISP_TEST_LIBRARY='$(abspath $(BUILD_DIR)/ffitest.dylib)' sh build-support/run-qa.sh ./newlisp qa-specific-tests/qa-ffi-storage $(BUILD_DIR)/qa-ffi-storage.log
	NEWLISP_TEST_LIBRARY='$(abspath $(BUILD_DIR)/ffitest.dylib)' sh build-support/run-qa.sh ./newlisp qa-specific-tests/qa-ffi-abi $(BUILD_DIR)/qa-ffi-abi.log

CORE_QA := qa-specific-tests/qa-integer-boundaries qa-specific-tests/qa-read-line qa-specific-tests/qa-ttest-bounds qa-specific-tests/qa-xml-bounds qa-specific-tests/qa-bigint-division qa-dot qa-specific-tests/qa-dictionary qa-specific-tests/qa-xml  qa-specific-tests/qa-json qa-specific-tests/qa-ref qa-specific-tests/qa-blockmemory  qa-specific-tests/qa-exception qa-specific-tests/qa-float qa-specific-tests/qa-foop  qa-specific-tests/qa-inplace qa-specific-tests/qa-longnum
.PHONY: core-check
core-check: ffi-check
	@set -e; for test in $(CORE_QA); do 	  sh build-support/run-qa.sh ./newlisp $$test $(BUILD_DIR)/$$(basename $$test).log; 	done
	sh build-support/run-qa.sh ./newlisp qa-specific-tests/qa-bigint $(BUILD_DIR)/qa-bigint.log 10000

# Library objects must not reuse executable objects compiled without LIBRARY.
LIB_SOURCES := $(SOURCES) unix-lib.c
LIB_OBJECTS := $(LIB_SOURCES:%.c=$(BUILD_DIR)/lib/%.o)
LIBRARY := $(BUILD_DIR)/newlisp.dylib
.PHONY: shared embedding-check
shared: $(LIBRARY)
	cp $(LIBRARY) newlisp.dylib

$(BUILD_DIR)/lib/%.o: %.c makefile_darwin_arm64 $(BUILD_DIR)/deps.mk
	@mkdir -p $(BUILD_DIR)/lib
	$(CC) $(CPPFLAGS) $(DEP_CPPFLAGS) $(REQUIRED_CPPFLAGS) -DLIBRARY $(CFLAGS) $(MODE_FLAGS) -fPIC -Wall -isysroot "$(SDKROOT)" -arch arm64 -MMD -MP -c $< -o $@

$(LIBRARY): $(LIB_OBJECTS)
	$(CC) $(CFLAGS) $(MODE_FLAGS) $(LIB_OBJECTS) $(LDFLAGS) $(DEP_LDFLAGS) -isysroot "$(SDKROOT)" -arch arm64 -dynamiclib -Wl,-install_name,@rpath/newlisp.dylib $(LDLIBS) -lm -lreadline -lffi -o $@

$(BUILD_DIR)/embedding-test: util/embedding-test.c $(BUILD_DIR)/deps.mk
	$(CC) $(CPPFLAGS) $(CFLAGS) $(MODE_FLAGS) -isysroot "$(SDKROOT)" -arch arm64 $< $(LDFLAGS) $(LDLIBS) -o $@

embedding-check: all shared $(BUILD_DIR)/embedding-test
	@unset NEWLISPLIB_INIT; $(BUILD_DIR)/embedding-test '$(abspath $(LIBRARY))' > $(BUILD_DIR)/embedding-test.log 2>&1; status=$$?; cat $(BUILD_DIR)/embedding-test.log; exit $$status
	unset NEWLISPLIB_INIT; NEWLISP_EMBED_LIBRARY='$(abspath $(LIBRARY))' sh build-support/run-qa.sh ./newlisp qa-specific-tests/qa-embedding $(BUILD_DIR)/qa-embedding.log

-include $(LIB_OBJECTS:.o=.d)

.PHONY: print-binary
print-binary:
	@printf '%s\n' '$(abspath $(BINARY))'

.PHONY: pgo-train
pgo-train:
	@test "$(MODE)" = pgo-generate || { echo "Use MODE=pgo-generate for pgo-train" >&2; exit 2; }
	$(PGO_ENV) python3 build-support/pgo.py train '$(PROFILE)'
