# Native Apple Silicon executable. Keep objects separate by configuration.
.DEFAULT_GOAL := all
ifeq ($(origin CC),default)
CC := $(shell xcrun --find clang)
endif
CC ?= $(shell xcrun --find clang)
SDKROOT ?= $(shell xcrun --sdk macosx --show-sdk-path)
CFLAGS ?= -O1 -g
MODE ?= baseline
ARCH := arm64
REQUIRED_CPPFLAGS := -DREADLINE -DNEWLISP64 -DMAC_OSX -DSUPPORT_UTF8 -DFFI
SOURCES := newlisp.c nl-symbol.c nl-math.c nl-list.c nl-liststr.c nl-string.c \
 nl-filesys.c nl-sock.c nl-import.c nl-xml-json.c nl-web.c nl-matrix.c \
 nl-debug.c pcre.c nl-utf8.c
CONFIG_KEY := $(shell printf '%s\n' '$(SDKROOT)' '$(CC)' '$(CPPFLAGS)' '$(CFLAGS)' '$(LDFLAGS)' '$(LDLIBS)' | shasum | cut -c1-12)
BUILD_DIR := build/$(ARCH)/$(MODE)/$(CONFIG_KEY)
OBJECTS := $(SOURCES:%.c=$(BUILD_DIR)/%.o)
BINARY := $(BUILD_DIR)/newlisp

.PHONY: all clean FORCE
all: $(BINARY)
	cp $(BINARY) newlisp

$(BUILD_DIR)/deps.mk: build-support/apple-silicon-deps.sh makefile_darwin_arm64
	@SDKROOT='$(SDKROOT)' CC='$(CC)' CPPFLAGS='$(CPPFLAGS)' CFLAGS='$(CFLAGS)' LDFLAGS='$(LDFLAGS)' LDLIBS='$(LDLIBS)' sh $< $@

ifneq ($(MAKECMDGOALS),clean)
include $(BUILD_DIR)/deps.mk
endif

$(BUILD_DIR)/%.o: %.c makefile_darwin_arm64 $(BUILD_DIR)/deps.mk
	$(CC) $(CPPFLAGS) $(DEP_CPPFLAGS) $(REQUIRED_CPPFLAGS) $(CFLAGS) -Wall -isysroot "$(SDKROOT)" -arch arm64 -MMD -MP -c $< -o $@

$(BINARY): $(OBJECTS)
	$(CC) $(CFLAGS) $(OBJECTS) $(LDFLAGS) $(DEP_LDFLAGS) -isysroot "$(SDKROOT)" -arch arm64 $(LDLIBS) -lm -lreadline -lffi -o $@

clean:
	rm -rf build/arm64

-include $(OBJECTS:.o=.d)
